# Copy this file to .env and fill in real values. .env is gitignored --
# never commit actual credentials.

POSTGRES_DB=aegis
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=change_me

# Must match the three values above. Format:
# postgresql+psycopg://<user>:<password>@<host>:5432/<db>
#
# host is "postgres" (the Compose service name, resolved by Docker's
# internal DNS) ONLY when something is running INSIDE the Compose
# network -- the api container, or `docker compose run --rm api ...`.
# It will NOT resolve if you run alembic/pytest directly on your host
# machine (e.g. from PowerShell) -- use "localhost" there instead,
# against the port Compose publishes (5432).
DATABASE_URL=postgresql+psycopg://aegis_user:change_me@postgres:5432/aegis

# Integration tests (tests/test_api.py) use this instead, and never
# fall back to DATABASE_URL above -- it points at a separate database
# (created automatically by docker/init-test-db.sql) so tests can
# freely create/drop tables without touching real data. Use localhost
# here even though DATABASE_URL above uses "postgres", per the note.
TEST_DATABASE_URL=postgresql+psycopg://aegis_user:change_me@localhost:5432/aegis_test

# Phase 2.5 -- live execution. Kept entirely separate from the two
# variables above: this is where Aegis actually WRITES corrected
# data, never Aegis's own governance database. Must never be "aegis"
# or "aegis_test" -- enforced in code, not just convention.
LIVE_DATABASE_URL=postgresql+psycopg://aegis_user:change_me@postgres:5432/some_external_db

# Test-only counterpart to LIVE_DATABASE_URL, same reasoning as
# TEST_DATABASE_URL above -- a real but disposable target so live-write
# tests never touch a real external system. Created automatically by
# docker/init-test-db.sql.
LIVE_TEST_DATABASE_URL=postgresql+psycopg://aegis_user:change_me@localhost:5432/aegis_live_test

# Off by default -- live execution is refused entirely unless this is
# exactly "true". See Docs/phase2_5_live_execution_spec.md.
AEGIS_LIVE_EXECUTION_ENABLED=false

# Comma-separated list of Postgres schemas live execution is allowed
# to target. Empty by default -- nothing is allowlisted until you add
# one explicitly.
AEGIS_LIVE_TARGET_SCHEMA_ALLOWLIST=
