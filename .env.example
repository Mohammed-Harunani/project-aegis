# Copy this file to .env and fill in real values. .env is gitignored --
# never commit actual credentials.

POSTGRES_DB=aegis
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=change_me

# Must match the three values above. Format:
# postgresql+psycopg://<user>:<password>@<host>:5432/<db>
# host is "postgres" (the Compose service name) when running via
# docker-compose, or "localhost" when running the API outside Docker
# against a locally-published Postgres port.
DATABASE_URL=postgresql+psycopg://aegis_user:change_me@postgres:5432/aegis
